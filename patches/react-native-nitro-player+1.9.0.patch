+  /// The 16:9 band in the middle of a 4:3 YouTube frame (drops the black bars above and below).
+  static func letterboxCropped(_ image: UIImage) -> UIImage {
+    guard let cg = image.cgImage else { return image }
+    let w = cg.width, h = cg.height
+    let band = w * 9 / 16
+    guard band > 0, band < h, let c = cg.cropping(to: CGRect(x: 0, y: (h - band) / 2, width: w, height: band)) else { return image }
+    return UIImage(cgImage: c, scale: image.scale, orientation: image.imageOrientation)
+  }
+
+  /// Center square of a non-square image (unchanged when already within 2% of square).
+  static func squareCropped(_ image: UIImage) -> UIImage {
+    guard let cg = image.cgImage else { return image }
+    let w = cg.width, h = cg.height
+    let side = min(w, h)
+    guard side > 0, abs(w - h) > side / 50,
+      let c = cg.cropping(to: CGRect(x: (w - side) / 2, y: (h - side) / 2, width: side, height: side))
+    else { return image }
+    return UIImage(cgImage: c, scale: image.scale, orientation: image.imageOrientation)
+  }
