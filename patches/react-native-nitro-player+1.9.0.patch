+package com.margelo.nitro.nitroplayer.core
+
+import android.content.Context
+import android.content.Intent
+
+/**
+ * Sangeet patch: tells the app (modules/audio-events) what changed playback from outside, so its playback-intent
+ * watchdog does not fight a pause the user or the system caused. Package-scoped broadcast, never exported.
+ */
+internal object NitroPlayerEvents {
+    const val ACTION = "com.margelo.nitro.nitroplayer.EVENT"
+
+    fun emit(
+        context: Context,
+        type: String,
+        value: String,
+    ) {
+        try {
+            context.sendBroadcast(
+                Intent(ACTION).setPackage(context.packageName).putExtra("type", type).putExtra("value", value),
+            )
+        } catch (_: Exception) {
+        }
+    }
+}
