+  private func fetchArtwork(_ urls: [URL], completion: @escaping (UIImage?, Bool) -> Void) {
+    guard let u = urls.first else { return completion(nil, false) }
+    URLSession.shared.dataTask(with: u) { [weak self] data, response, _ in
