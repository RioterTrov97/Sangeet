# Copy to .env.local (git-ignored) and set your own values. Loaded by Expo and by every script in scripts/.
# iOS bundle identifier AND Android applicationId. Pick one you own; keep it stable so installed apps update in place.
SANGEET_BUNDLE_ID=com.example.sangeet
# Apple Developer Team ID (10 characters). Can also live in .env.device / .env.testflight.
APPLE_TEAM=XXXXXXXXXX
# Optional: GitHub repo (owner/name) whose Releases the Android TV app updates itself from. Unset = no updater. CI sets it for release builds.
# SANGEET_UPDATE_REPO=owner/name
