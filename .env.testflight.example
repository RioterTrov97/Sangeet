# Copy to .env.testflight (git-ignored) and fill in. Used by scripts/testflight.sh.
# SANGEET_BUNDLE_ID and APPLE_TEAM live in .env.local (see .env.local.example); APPLE_TEAM here also works.
# fastlane match: certificates and profiles, encrypted, in a PRIVATE git repo (never public). Run scripts/testflight.sh certs once.
# Offline alternative: a local bare repo (git init --bare ~/sangeet-certs.git) with the file:// URL below.
MATCH_GIT_URL=file://$HOME/sangeet-certs.git
MATCH_PASSWORD=choose-a-long-random-passphrase
# MATCH_GIT_BRANCH=main
# Extension targets later: comma-separated extra identifiers (each also needs a profile mapping, see fastlane/Matchfile)
# SANGEET_EXTRA_BUNDLE_IDS=
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Keep the .p8 outside the repo
ASC_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
# CI alternative to ASC_KEY_PATH: base64 of the .p8
# ASC_KEY_CONTENT=
# CarPlay entitlement needs Apple approval first; 1 turns it on
# SANGEET_CARPLAY=0
# What to Test: optional feedback address shown to testers
# BETA_FEEDBACK_EMAIL=
# SKIP_GATES=1 skips tsc/eslint/jest before an upload (loud warning); ALLOW_ANY_REF=1 ships a ref that is not on main
# Listing (scripts/testflight.sh metadata): where docs/privacy-policy.html and your support page are hosted
PRIVACY_URL=https://example.com/sangeet/privacy
SUPPORT_URL=https://example.com/sangeet/support
# App Review contact, only for `bundle exec fastlane ios submit_review` (never committed)
REVIEW_FIRST_NAME=
REVIEW_LAST_NAME=
REVIEW_EMAIL=
REVIEW_PHONE=
# App Store listing language (primary language in App Store Connect); folder name under fastlane/metadata and fastlane/screenshots
# SANGEET_LISTING_LOCALE=en-AU
