# Lanes run from the build worktree, where the generated ios/ exists (see scripts/testflight.sh).
# Secrets come from ENV (scripts/testflight.sh sources .env.testflight; GitHub Actions can supply them as secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY_PATH (path to AuthKey_XXX.p8) or ASC_KEY_CONTENT (base64 of the .p8).
#   Listing (lane `metadata`): PRIVACY_URL, SUPPORT_URL. Review submission (lane `submit_review`): REVIEW_FIRST_NAME,
#   REVIEW_LAST_NAME, REVIEW_EMAIL, REVIEW_PHONE. Optional: BETA_FEEDBACK_EMAIL, SKIP_GATES=1, WITH_SCREENSHOTS=1.
# Signing is fastlane match (certificates and profiles encrypted in a git repo): MATCH_GIT_URL, MATCH_PASSWORD, optional
# MATCH_GIT_BRANCH. Identity (SANGEET_BUNDLE_ID, APPLE_TEAM) comes from ENV; see .env.local.example. One-time setup: lane `certs`.

default_platform(:ios)

def asc_key_file
  return ENV["ASC_KEY_PATH"] if ENV["ASC_KEY_PATH"] && !ENV["ASC_KEY_PATH"].empty?
  content = ENV["ASC_KEY_CONTENT"]
  UI.user_error!("Set ASC_KEY_PATH or ASC_KEY_CONTENT") if content.nil? || content.empty?
  require "base64"
  require "tmpdir"
  path = File.join(Dir.mktmpdir("asc"), "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
  File.write(path, Base64.decode64(content), perm: 0o600)
  path
end

ROOT = File.expand_path("..", __dir__)
METADATA_DIR = File.join(ROOT, "fastlane", "metadata")
SCREENSHOTS_DIR = ENV["SCREENSHOTS_PATH"].to_s.empty? ? File.join(ROOT, "fastlane", "screenshots") : ENV["SCREENSHOTS_PATH"]
CHANGELOG_FILE = File.join(ROOT, "build", "testflight", "changelog.txt")
CHANGELOG_LIMIT = 4000 # App Store Connect's limit for "What to Test"
LISTING_LOCALE = ENV["SANGEET_LISTING_LOCALE"].to_s.empty? ? "en-AU" : ENV["SANGEET_LISTING_LOCALE"] # the App Store listing language (primary language in App Store Connect)
LAST_UPLOAD_FILE = File.join(ROOT, "build", "testflight", "last-uploaded-build.txt") # "<version> <build>", kept between runs

def require_env(*keys, hint: nil)
  missing = keys.select { |k| ENV[k].to_s.empty? }
  UI.user_error!("Missing #{missing.join(', ')}#{hint ? " (#{hint})" : ''}. See .env.testflight.example.") unless missing.empty?
end

def asc_api_key
  require_env("ASC_KEY_ID", "ASC_ISSUER_ID")
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: asc_key_file,
    in_house: false
  )
end

# "What to Test": commit subjects since the last testflight/* tag (the last 20 commits when there is none), within Apple's limit.
def build_changelog
  last_tag = `git -C #{ROOT.shellescape} describe --tags --match 'testflight/*' --abbrev=0 2>/dev/null`.strip
  range = last_tag.empty? ? ["-n", "20"] : ["#{last_tag}..HEAD"]
  lines = `git -C #{ROOT.shellescape} log --no-merges --format='• %s' #{range.join(' ')}`.split("\n").reject(&:empty?)
  lines = ["• Internal build"] if lines.empty?
  text = lines.join("\n")
  if text.length > CHANGELOG_LIMIT
    kept = []
    lines.each do |line|
      tail = "• …and #{lines.length - kept.length} more"
      break if (kept + [line, tail]).join("\n").length > CHANGELOG_LIMIT
      kept << line
    end
    text = (kept + ["• …and #{lines.length - kept.length} more"]).join("\n")
  end
  FileUtils.mkdir_p(File.dirname(CHANGELOG_FILE))
  File.write(CHANGELOG_FILE, text + "\n")
  UI.message("What to Test (#{last_tag.empty? ? 'last 20 commits' : "since #{last_tag}"}, #{lines.length} commits, #{text.length} chars): #{CHANGELOG_FILE}")
  text
end

def bundle_id
  id = ENV["SANGEET_BUNDLE_ID"].to_s
  UI.user_error!("Set SANGEET_BUNDLE_ID to your real bundle ID (.env.local)") if id.empty? || id == "com.example.sangeet"
  id
end

# Signs with the match-managed App Store certificate and profile (read-only: `certs` creates them once).
def prepare_build
  require_env("MATCH_GIT_URL", "MATCH_PASSWORD", "APPLE_TEAM", hint: "run scripts/testflight.sh certs once; see docs/INSTALL.md")
  asc_api_key
  setup_ci if ENV["CI"]
  match(type: "appstore", readonly: true, api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY])
  profile = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
  project = "ios/Sangeet.xcodeproj"
  update_code_signing_settings(
    use_automatic_signing: false,
    path: project,
    team_id: ENV["APPLE_TEAM"],
    code_sign_identity: "Apple Distribution",
    profile_name: profile[bundle_id],
    bundle_identifier: bundle_id,
    targets: ["Sangeet"]
  )
  version = get_version_number(xcodeproj: project, target: "Sangeet")
  latest = latest_testflight_build_number(version: version, initial_build_number: 0)
  # A build Apple rejected during processing never shows up in TestFlight, but its number is still used, so also go past
  # the last number this machine uploaded (LAST_UPLOAD_FILE) and an explicit SANGEET_BUILD_NUMBER override.
  uploaded = File.exist?(LAST_UPLOAD_FILE) ? File.read(LAST_UPLOAD_FILE).strip.split(" ") : []
  local_last = uploaded[0] == version ? uploaded[1].to_i : 0
  build = [latest + 1, local_last + 1, ENV["SANGEET_BUILD_NUMBER"].to_i].max
  increment_build_number(build_number: build, xcodeproj: project)
  UI.message("Version #{version}, build #{build}")
  File.write(File.join(ROOT, "build-number.txt"), "#{version} (#{build})\n")

  build_app(
    workspace: "ios/Sangeet.xcworkspace",
    scheme: "Sangeet",
    configuration: "Release",
    export_method: "app-store",
    output_directory: "build/testflight",
    output_name: "Sangeet.ipa",
    export_options: { provisioningProfiles: profile }
  )
  [version, build]
end

# Shared deliver options for the listing lanes. The privacy and support URLs come from ENV (no URLs are committed).
# The privacy and support URLs are needed to submit for review; a draft listing can be pushed without them.
def listing_options(require_urls: false)
  urls = %w[PRIVACY_URL SUPPORT_URL]
  if require_urls
    require_env(*urls, hint: "review needs both; host docs/privacy-policy.html and set them")
  elsif urls.any? { |k| ENV[k].to_s.empty? }
    UI.important("PRIVACY_URL / SUPPORT_URL not set: pushing the listing without them (needed before review)")
  end
  opts = {
    app_identifier: bundle_id,
    metadata_path: METADATA_DIR,
    app_rating_config_path: File.join(METADATA_DIR, "app_rating_config.json"),
    screenshots_path: SCREENSHOTS_DIR,
    skip_binary_upload: true,
    force: true, # no HTML preview prompt
    precheck_include_in_app_purchases: false,
    run_precheck_before_submit: false
  }
  opts[:privacy_url] = { LISTING_LOCALE => ENV["PRIVACY_URL"] } unless ENV["PRIVACY_URL"].to_s.empty?
  opts[:support_url] = { LISTING_LOCALE => ENV["SUPPORT_URL"] } unless ENV["SUPPORT_URL"].to_s.empty?
  opts
end

def review_contact_set?
  %w[REVIEW_FIRST_NAME REVIEW_LAST_NAME REVIEW_EMAIL REVIEW_PHONE].all? { |k| !ENV[k].to_s.empty? }
end

def review_info
  info = { notes: File.read(File.join(METADATA_DIR, "review_notes.txt")).strip }
  { first_name: "REVIEW_FIRST_NAME", last_name: "REVIEW_LAST_NAME", email_address: "REVIEW_EMAIL", phone_number: "REVIEW_PHONE" }
    .each { |k, env| info[k] = ENV[env] unless ENV[env].to_s.empty? }
  info
end

platform :ios do
  desc "ONE-TIME: create or fetch the App Store certificate and profile with match (writes to MATCH_GIT_URL)"
  lane :certs do
    require_env("MATCH_GIT_URL", "MATCH_PASSWORD", "APPLE_TEAM")
    bundle_id
    asc_api_key
    begin
      match(type: "appstore", readonly: false, api_key: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY])
    rescue => e
      UI.error("match failed: #{e.message}")
      UI.important("If Apple refused to create a certificate with the API key (it may require an Account Holder Apple ID session), run this yourself in a terminal and sign in with your Apple ID:\n  set -a; . ./.env.local; . ./.env.testflight; set +a; bundle exec fastlane match appstore\nNever put your Apple ID password in a file or script.")
      raise
    end
  end

  desc "Run the CI gates in this checkout: tsc, eslint, jest"
  lane :gates do
    sh("cd #{ROOT.shellescape} && npx tsc --noEmit")
    sh("cd #{ROOT.shellescape} && npx eslint src app")
    sh("cd #{ROOT.shellescape} && npx jest --ci")
    UI.success("Gates passed")
  end

  desc "Build the IPA without uploading (checks signing)"
  lane :build_only do
    prepare_build
  end

  desc "Gates, build, upload to TestFlight (internal testing only) with generated What to Test"
  lane :beta do
    if ENV["SKIP_GATES"] == "1"
      UI.important("!!! SKIP_GATES=1: shipping WITHOUT tsc, eslint and jest !!!")
    else
      gates
    end
    version, build = prepare_build
    changelog = build_changelog
    UI.message("Uploading, then waiting for Apple to process the build (up to 1 h) so What to Test can be attached")
    opts = {
      ipa: "build/testflight/Sangeet.ipa",
      changelog: changelog,
      beta_app_description: File.read(File.join(METADATA_DIR, LISTING_LOCALE, "beta_description.txt")).strip,
      distribute_external: false,
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 3600
    }
    opts[:beta_app_feedback_email] = ENV["BETA_FEEDBACK_EMAIL"] unless ENV["BETA_FEEDBACK_EMAIL"].to_s.empty?
    File.write(LAST_UPLOAD_FILE, "#{version} #{build}\n") # before upload: a number Apple saw is never reused
    upload_to_testflight(**opts)
    tag = "testflight/#{version}-#{build}"
    sh("cd #{ROOT.shellescape} && git tag -a #{tag.shellescape} -m #{"TestFlight #{version} (#{build})".shellescape} HEAD")
    UI.success("Tagged #{tag} (local only, not pushed)")
  end

  desc "Capture App Store screenshots on the simulator into fastlane/screenshots/#{LISTING_LOCALE}"
  lane :screenshots do
    sh("#{File.join(ROOT, 'scripts', 'screenshots.sh').shellescape}")
  end

  desc "Push the listing (text, age rating, categories, URLs) to App Store Connect; never submits. WITH_SCREENSHOTS=1 also uploads screenshots"
  lane :metadata do
    asc_api_key
    with_shots = ENV["WITH_SCREENSHOTS"] == "1"
    upload_to_app_store(
      **listing_options,
      submit_for_review: false,
      skip_screenshots: !with_shots,
      overwrite_screenshots: with_shots,
      # App Review details (notes + contact) go up only when the REVIEW_* contact values are set in ENV: Apple rejects an
      # update without them. (A first version with no review details at all makes deliver fail with "No data"; set them then.)
      **(review_contact_set? ? { app_review_information: review_info } : {})
    )
  end

  desc "MANUAL ONLY: submit the current listing and latest build for App Review (asks first)"
  lane :submit_review do
    require_env("REVIEW_FIRST_NAME", "REVIEW_LAST_NAME", "REVIEW_EMAIL", "REVIEW_PHONE")
    UI.important("Guideline 5.2.3: Apple is likely to reject third-party YouTube clients. Submit only if you have thought about that.")
    UI.user_error!("Not submitted.") unless UI.confirm("Submit Sangeet for App Review now?")
    asc_api_key
    upload_to_app_store(
      **listing_options(require_urls: true),
      submit_for_review: true,
      automatic_release: false,
      skip_screenshots: true,
      skip_metadata: false,
      app_review_information: {
        first_name: ENV["REVIEW_FIRST_NAME"],
        last_name: ENV["REVIEW_LAST_NAME"],
        email_address: ENV["REVIEW_EMAIL"],
        phone_number: ENV["REVIEW_PHONE"]
      }
    )
  end
end
